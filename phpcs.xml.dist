<?xml version="1.0"?>

	<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="lumiere_phpcs" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>Lumière WordPress Plugin PHP Code Sniffer configuration file.</description>

	<file>src</file>

	<arg name="basepath" value="./"/>
	<!--<arg name="colors"/>-->
	<arg value="s"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="warning-severity" value="0"/>

	<exclude-pattern>*/assets/js/*</exclude-pattern>
	<exclude-pattern>*/assets/css/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>phan.php</exclude-pattern>

	<!-- Include the WordPress-Extra standard.-->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/><!-- I don't want to add 'class-' to class file names -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/><!-- I want to use [] for arrays -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/><!-- I don't want to add "-" to class file names, I want to use "_" -->
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen"/><!-- supposed to have the closing/opening PHP code on a new line, but I prefer my design -->
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd"/><!-- supposed to have the closing/opening PHP code on a new line, but I prefer my design -->
		<exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterEnd"/><!-- supposed to have the closing/opening PHP code on a new line, but I prefer my design -->
		<exclude name="WordPress.PHP.IniSet.display_errors_Disallowed"/><!-- It's not active by default -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/><!-- I want to use short array [] -->
		<exclude name="WordPress.PHP.YodaConditions"/><!-- Yoda conditions to the bin, you go -->
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/><!-- Covers rule: Put spaces on both sides of the opening and closing parenthesis of
										 if, elseif, foreach, for, and switch blocks. I don't want it. -->
		<exclude name="NeutronStandard.Functions.DisallowCallUserFunc.CallUserFunc"/><!-- I want to use call_user_func() -->
		<exclude name="WordPress.Security.NonceVerification"/><!-- Using a custom rule later -->
		<exclude name="NeutronStandard.Constants.DisallowDefine.Define"/><!-- I want to use define() -->
	</rule> 

	<!-- Let's also check that everything is properly documented. Allow modern class naming (PSR-4)
	<rule ref="WordPress-Docs">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>
	-->

	<!-- Add in some extra rules from other standards. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	<!--
	<rule ref="Generic.Commenting.Todo"/>
	-->

	<!--
	Let's play with WP Coding standards and fit Lumiere needs
	https://github.com/WordPress/WordPress-Coding-Standards/wiki/Customizable-sniff-properties
	-->
	<config name="minimum_supported_wp_version" value="6.1"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lumiere-movies"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lumiere"/>
			</property>
		</properties>
	</rule>
	
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="absint"/>
				<element value="map_deep"/>
				<element value="esc_url_raw"/>
				<element value="sanitize_text_field"/>
				<element value="sanitize_key"/>
			</property>
		</properties>
	</rule>
	
	<rule ref="WordPress.Security.NonceVerification">
		<properties>
			<property name="customNonceVerificationFunctions" type="array">
				<element value="is_valid_nonce"/>
				<element value="is_valid_nonce_die"/>
				<element value="check_nonce"/>
				<element value="check_nonce_die"/>
			</property>
		</properties>
	</rule>
</ruleset>
