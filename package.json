{
  "name": "lumiereWordpress",
  "description": "Lumière Movies WordPress plugin",
  "keywords": [
    "movies",
    "imdb",
    "wordpress",
    "plugin",
    "film"
  ],
  "author": "JC Vignoli <dev@jcvignoli.com> (https://www.jcvignoli.com)",
  "homepage": "https://github.com/jcvignoli/lumiere-movies#README",
  "license": "GPL-3.0",
  "scripts": {
    "start": "wp-scripts start --progress --mode development --blocks-manifest",
    "build": "if [ -d dist ] && [ -s dist ]; then rm -R dist; fi; wp-scripts build --progress --mode production --blocks-manifest",
    "wp:lint_css": "wp-scripts lint-style",
    "wp:lint_js": "wp-scripts lint-js",
    "codeception:start": "php vendor/bin/codecept run --env wpchrome -vvv tests/codeception/Acceptance/000-StartCest.php",
    "codeception:remote": "php vendor/bin/codecept run --env wpchrome -vvv AcceptanceRemote",
    "codeception:local": "php vendor/bin/codecept run --env wpchrome -vvv Acceptance",
    "codeception:unit": "vendor/bin/codecept run Unit",
    "phan": "vendor/bin/phan -k phan.php --color --output-mode=text -p | tee tmp/logs/Results-phan.txt",
    "phpcs": "vendor/bin/phpcs -s -p --report=code | tee tmp/logs/Results-phpcs-wp.txt",
    "phpdd": "vendor/bin/phpdd ./src --exclude $(grep -oP \"(?<=^exclude: )[^/]+\" phpdd.dist) | tee tmp/logs/Results-phpdd-deprecated.txt",
    "phpdoc": "phpDocumentor run",
    "phpmd": "vendor/bin/phpmd src html ./phpmd.xml.dist > tmp/logs/Results-phpmd.html",
    "phpstan": "vendor/bin/phpstan -v | tee tmp/logs/Results-phpstan.txt",
    "phpstan-clean": "if [ -d \"tmp/cache/phpstan\" ];then rm -R tmp/cache/phpstan && npm run phpstan; else npm run phpstan; fi",
    "plugincheck": "wp @lumiere plugin check lumiere-movies --ignore-codes='WordPress.Security.NonceVerification.Recommended,WordPress.Security.NonceVerification.Missing,WordPress.PHP.DevelopmentFunctions.error_log_wp_debug_backtrace_summary, WordPress.PHP.DevelopmentFunctions.error_log_debug_backtrace'",
    "psalm": "vendor/bin/psalm --show-info=true --report=tmp/logs/Results-psalm.txt",
    "test": "npm run codeception:unit && npm run plugincheck"
  },
  "devDependencies": {
    "@alexrah/ssh-watch-upload-webpack-plugin": "^1.1.1",
    "@wordpress/plugins": "^7.52.0",
    "@wordpress/scripts": "^34.0.0",
    "browser-sync-webpack-plugin": "^2.4.0",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "semver-regex": "^3.1.3",
    "got": "^11.8.5",
    "cross-spawn": "^6.0.6",
    "@opentelemetry/core": "^2.8.0",
    "adm-zip": "^0.6.0",
    "serialize-javascript": "^7.0.5",
    "immutable": "^4.3.9",
    "linkify-it": "^5.0.0",
    "markdown-it": "^14.1.2",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
